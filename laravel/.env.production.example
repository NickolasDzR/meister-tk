# Боевой сервер (tk-meister.ru). Шаблон без секретов: на сервере
# скопировать в .env.production и заполнить. Сам файл с ключами
# в git не кладётся.

APP_NAME="Мейстер"
APP_ENV=production
# Новый ключ, не локальный: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://tk-meister.ru

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Moscow

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# В лог — только то, что требует внимания
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=meister
DB_USERNAME=meister
# Длинный случайный: openssl rand -base64 24
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Куки сессии — только по https
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nickolasdzr@yandex.ru"
MAIL_FROM_NAME="${APP_NAME}"

# false, пока пишутся первые статьи. Открыть: true + php artisan config:cache
SITE_INDEXING=false

# Ключ карт: в кабинете Яндекса домен tk-meister.ru должен быть в разрешённых
YMAP_API_KEY=

DADATA_API_KEY=
DADATA_SECRET_KEY=

# Telegram-бот для анонсов статей в канал. Пусто — отправка выключена.
# Здесь только шаблон: настоящий токен — в .env (локально) или .env.production (на сервере).
# Канал: @имя для публичного (не ссылка t.me), -100… для приватного
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

YANDEX_ACCESS_KEY=
YANDEX_SECRET_KEY=
YANDEX_BUCKET=
YANDEX_FOLDER=
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_REGION=ru-central1

VITE_APP_NAME="${APP_NAME}"
