# Локальная разработка. Скопировать в .env и заполнить ключи.
# Боевые значения — в .env.production.example.

APP_NAME="Мейстер"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://dev.local:8083

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=Europe/Moscow

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# База — контейнер db из docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=meister_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Писем сайт не шлёт; если начнёт — на время разработки они падают в лог
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Пускать ли поисковики (robots.txt и meta robots). Локально — неважно.
SITE_INDEXING=false

# Яндекс.Карты — маршрут в форме расчёта (ключ ограничен доменами в кабинете)
YMAP_API_KEY=

# Dadata — подсказки городов. Только на сервере, в браузер не уходит.
DADATA_API_KEY=
DADATA_SECRET_KEY=

# Telegram-бот для анонсов статей в канал. Пусто — отправка выключена.
# Здесь только шаблон: настоящий токен — в .env (локально) или .env.production (на сервере).
# Канал: @имя для публичного (не ссылка t.me), -100… для приватного
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# Бакет Yandex Object Storage — картинки статей
YANDEX_ACCESS_KEY=
YANDEX_SECRET_KEY=
YANDEX_BUCKET=
YANDEX_FOLDER=
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_REGION=ru-central1

VITE_APP_NAME="${APP_NAME}"
