# Caddy Мейстера: раздаёт статику и передаёт PHP-запросы в контейнер app.
# Слушает только :80 во внутренней сети. Снаружи запросы на tk-meister.ru принимает Caddy Битулята
# (HTTPS, сертификат) и пересылает сюда — на meister-web:80 по общей сети edge.
{
	auto_https off
	servers {
		# Запросы приходят от Caddy Битулята: верим его X-Forwarded-*, иначе Laravel
		# решит, что сайт открыт по http, и у счётчика просмотров все посетители будут с одного адреса
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /var/www/laravel/public
	encode zstd gzip
	request_body {
		max_size 20MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Собранные Vite файлы: в имени хеш, поэтому браузер хранит их год
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi app:9000
	file_server
}
